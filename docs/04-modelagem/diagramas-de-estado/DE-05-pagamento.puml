@startuml DE-05-pagamento
!include _estilo.iuml
title DE-05 · Pagamento (Pagamento.status: StatusPagamento) e reembolso

state Pagamento {
  [*] --> PENDENTE : iniciar() / cria cobrança no gateway
  PENDENTE --> ACEITO : confirmação do gateway\n/ dataConfirmacao (RN39)
  PENDENTE --> RECUSADO : gateway recusa
  PENDENTE --> CANCELADO : tutor cancela antes da confirmação
  RECUSADO --> [*]
  CANCELADO --> [*]
}

state "Reembolso (SolicitacaoReembolso.status)" as Reembolso {
  [*] --> EM_ANALISE : solicitar reembolso [pagamento ACEITO]
  EM_ANALISE --> APROVADO : aprovar() / estorno no gateway
  EM_ANALISE --> NEGADO : negar(motivo)
  APROVADO --> [*]
  NEGADO --> [*]
}

ACEITO --> Reembolso : tutor solicita reembolso
@enduml
