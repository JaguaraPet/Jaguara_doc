@startuml C4-02-conteineres
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title C4-02 · Diagrama de contêineres do Jaguara

Person(tutor, "Tutor")
Person(empresa, "Empresa e funcionários")
Person(admin, "Administrador")

System_Boundary(jaguara, "Jaguara") {
  Container(app, "App do tutor", "React Native + Expo, TypeScript", "Pets, saúde, rotina, catálogo, solicitações, pagamentos e chat")
  Container(web, "Web Enterprise e administração", "React + Vite, TypeScript", "Catálogo, agenda, atendimentos, clientes, BI e administração")
  Container(api, "API", "NestJS, TypeScript", "Regras de negócio, autenticação, REST e WebSocket")
  Container(worker, "Worker", "NestJS + BullMQ", "Notificações, sincronizações e reenvio de webhooks")
  ContainerDb(db, "Banco de dados", "PostgreSQL 16", "Dados do domínio e auditoria")
  ContainerDb(redis, "Fila e cache", "Redis", "Jobs do BullMQ e adaptador do Socket.IO")
  ContainerDb(storage, "Armazenamento de arquivos", "Compatível com S3", "Fotos, documentos e laudos")
}

System_Ext(ext, "Serviços externos", "Pagamento, calendário, e-mail, push, IA")

Rel(tutor, app, "Usa")
Rel(empresa, web, "Usa")
Rel(admin, web, "Usa")
Rel(app, api, "Chama", "HTTPS/JSON e WebSocket")
Rel(web, api, "Chama", "HTTPS/JSON e WebSocket")
Rel(api, db, "Lê e grava", "Prisma / TCP")
Rel(api, redis, "Publica jobs e eventos")
Rel(worker, redis, "Consome jobs")
Rel(worker, db, "Lê e grava")
Rel(api, storage, "Gera URLs assinadas")
Rel(app, storage, "Envia e baixa arquivos", "URL assinada")
Rel(api, ext, "Integra", "HTTPS")
Rel(worker, ext, "Integra", "HTTPS")
@enduml
