@startuml C4-03-componentes-api
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title C4-03 · Componentes da API (módulos NestJS)

Container(clientes, "App e Web", "React Native / React")
ContainerDb(db, "PostgreSQL", "Banco de dados")
ContainerDb(redis, "Redis", "Fila e eventos")
System_Ext(ext, "Serviços externos")

Container_Boundary(api, "API (monólito modular)") {
  Component(http, "Camada HTTP e WebSocket", "Controllers, gateways, guards", "Autenticação, RBAC, validação e mapeamento de erros")
  Component(acesso, "acesso", "Módulo", "Usuários, sessões, tokens, perfis e permissões")
  Component(pet, "pet + saude", "Módulos", "Pets, responsáveis, compartilhamento, histórico clínico")
  Component(rotina, "rotina", "Módulo", "Calendário, calendários externos, alimentação")
  Component(atend, "atendimento", "Módulo", "Catálogo, agenda, solicitações, agendamentos, atendimentos, clientes")
  Component(fin, "financeiro", "Módulo", "Despesas, pagamentos, reembolsos, assinaturas")
  Component(com, "comunicacao + privacidade", "Módulos", "Chat, assistente, termos, consentimentos, LGPD")
  Component(notif, "notificacao", "Módulo", "Agendamento de notificações e preferências")
  Component(admin, "administracao + relatorios", "Módulos", "Auditoria, suporte, integrações, webhooks, relatórios e BI")
  Component(adapters, "Adaptadores de integração", "Portas e adaptadores", "Gateway, calendário, e-mail, push, IA, armazenamento")
  Component(prisma, "Persistência", "Prisma Client", "Repositórios e transações")
}

Rel(clientes, http, "HTTPS e WebSocket")
Rel(http, acesso, "Usa")
Rel(http, pet, "Usa")
Rel(http, rotina, "Usa")
Rel(http, atend, "Usa")
Rel(http, fin, "Usa")
Rel(http, com, "Usa")
Rel(http, admin, "Usa")
Rel(pet, notif, "Agenda lembretes")
Rel(rotina, notif, "Agenda lembretes")
Rel(atend, notif, "Agenda avisos")
Rel(atend, pet, "Consulta pets autorizados")
Rel(fin, atend, "Lê agendamentos")
Rel(notif, redis, "Jobs")
Rel(acesso, prisma, "Persiste")
Rel(pet, prisma, "Persiste")
Rel(atend, prisma, "Persiste")
Rel(fin, prisma, "Persiste")
Rel(admin, prisma, "Persiste")
Rel(prisma, db, "SQL")
Rel(fin, adapters, "Cobranças")
Rel(com, adapters, "Assistente")
Rel(notif, adapters, "Envio")
Rel(adapters, ext, "HTTPS")
@enduml
